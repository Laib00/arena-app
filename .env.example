# Copy this file to .env for local development with `npm run dev`.
# GEMINI_API_KEY is read by the local / Vite API (and by Vercel in production).
# In production (Vercel dashboard), set these under Project Settings > Environment Variables.
# Never commit your actual .env file.

LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k3

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
