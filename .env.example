# Copy this file to .env for local development with `npm run dev`.
# GEMINI_API_KEY is read by the local / Vite API (and by Vercel in production).
# In production (Vercel dashboard), set these under Project Settings > Environment Variables.
# Never commit your actual .env file.

LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Phase 3 RAG — same API key; used by /api/embeddings
# text-embedding-004 was removed from Gemini API Jan 2026; use gemini-embedding-001 or gemini-embedding-2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k3

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set true to show Education at signup (local / student trial). Leave unset/false for Property-only.
VITE_ENABLE_EDUCATION_PACK=false
